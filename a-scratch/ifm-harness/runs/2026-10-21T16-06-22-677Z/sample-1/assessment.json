    "fluid.demos.ai.noteImageGenerator": "// Combines the image generator (dominant) with the closest note finder (hidden supplier):\n// the prompt bound to the generator's input - and acted on by its \"Find Image\" button - is\n// replaced by the text of the sticky note closest to the widget, wherever it is placed.\nfluid.def(\"fluid.demos.ai.noteImageGenerator\", {\n    $layers: [\"fluid.demos.imageGenerator\", \"fluid.topLevelWidget\"],\n    // Hidden supplier: shares this shape's bounds and view, so it renders nothing of its own\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            view: \"{noteImageGenerator}.view\",\n            hostBounds: \"{noteImageGenerator}.hostBounds\"\n        }\n    },\n    // The member takes the note's text whenever the widget moves near a different note\n    state: {\n        prompt: \"{finder}.noteText\"\n    }\n});"
