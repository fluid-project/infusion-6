    "fluid.demos.ai.noteImageGen": "<script>\n// Composition of fluid.demos.closestNoteFinder and fluid.demos.imageGenerator: move this widget close\n// to a sticky note and press \"Find Image\" to search Pixabay for an image matching the note's text\nfluid.def(\"fluid.demos.ai.noteImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 640,\n        h: 480\n    },\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            // A subcomponent has no tldraw shape of its own, so it borrows the umbrella's canvas bounds\n            hostBounds: \"{noteImageGen}.hostBounds\"\n        }\n    },\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\",\n            // The closest note's text becomes the search prompt, tracking it as the widget moves\n            state: {prompt: \"{finder}.noteText\"}\n        }\n    }\n});\n</script>\n\n<template>\n    <div class=\"nig\">\n        <div @id=\"finder\"></div>\n        <div @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.nig {\n    display: flex;\n    gap: 12px;\n    height: 100%;\n}\n\n/* Sized structurally, since each subcomponent's own root element merges into its @id container */\n.nig > div {\n    height: 100%;\n    min-height: 0;\n}\n\n.nig > div:first-child {\n    flex: 0 0 240px;\n}\n\n.nig > div:last-child {\n    flex: 1 1 auto;\n    min-width: 0;\n}\n</style>"
