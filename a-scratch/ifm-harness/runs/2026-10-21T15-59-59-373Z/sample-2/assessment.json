    "fluid.demos.noteDrivenImageGenerator": "<script>\n// Combines fluflu.demos.closestNoteFinder with fluid.demos.imageGenerator: the text of the sticky note\n// closest to the widget becomes the prompt for the image search, so the widget can be dragged near a\n// note and its \"Find Image\" button pressed.\nfluid.def(\"fluid.demos.noteDrivenImageGenerator\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 360,\n        h: 640\n    },\n    // Reports on the note nearest to this widget's own tldraw shape - the finder's topLevelWidget-issued\n    // hostBounds cannot see our shape, so it is bound to ours\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            hostBounds: \"{noteDrivenImageGenerator}.hostBounds\"\n        }\n    },\n    generator: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\"\n        }\n    },\n    // The closest note's text becomes the image search prompt, kept in step as the widget is moved\n    syncImagePrompt: {\n        $effect: {\n            func: (state, prompt) => {\n                state.prompt = prompt;\n            },\n            args: [\"{generator}.state\", \"{finder}.closest.text\"]\n        }\n    }\n});\n</script>\n\n<template>\n    <div class=\"noteimage\">\n        <div @id=\"finder\" class=\"noteimage-finder\"></div>\n        <div @id=\"generator\" class=\"noteimage-generator\"></div>\n    </div>\n</template>\n\n<style>\n.noteimage {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n}\n\n.noteimage-finder {\n    flex: 0 0 auto;\n}\n\n.noteimage-generator {\n    flex: 1 1 auto;\n    min-height: 0;\n}\n</style>"
  },
