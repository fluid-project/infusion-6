    "fluid.demos.closestNoteImageGen": "<script>\n// Combines the closest-note finder with the image generator: the finder (top) watches the notes on the canvas and\n// its closest note's text feeds the generator's prompt (bottom), so moving the widget next to a sticky note and\n// pressing its button generates an image from that note.\n\nfluid.def(\"fluid.demos.closestNoteImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 360,\n        h: 680\n    },\n    noteFinder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            // Forward the hosting context from this umbrella widget down into the nested finder\n            hostBounds: \"{self}.hostBounds\",\n            tldrawHost: \"{tldrawHost}\"\n        }\n    },\n    imageGenerator: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\",\n            // The generator's prompt now tracks the closest note; it can still be edited by typing\n            state: {\n                prompt: \"{noteFinder}.noteText\"\n            }\n        }\n    }\n});\n</script>\n\n<template>\n    <div class=\"noteimg\">\n        <div @id=\"noteFinder\" class=\"noteimg-finder\"></div>\n        <div class=\"noteimg-gap\"></div>\n        <div @id=\"imageGenerator\" class=\"noteimg-generator\"></div>\n    </div>\n</template>\n\n<style>\n.noteimg {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    background-color: #fffbea;\n    border: 1px solid #f0e4c0;\n    border-radius: 6px;\n    overflow: hidden;\n}\n\n.noteimg-finder {\n    flex: 0 0 200px;\n}\n\n.noteimg-gap {\n    flex: 0 0 8px;\n}\n\n.noteimg-generator {\n    flex: 1 1 auto;\n    min-height: 0;\n}\n</style>"
