    "fluid.demos.noteImageGen": "<script>\n// Combines the closest-note finder with the Pixabay image generator: the generator seeks an image of the\n// sticky note nearest the widget, so the user can move the widget next to a note and press \"Find Image\"\n\nfluid.def(\"fluid.demos.noteImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 360,\n        h: 700\n    },\n    // Which sticky note is nearest the widget, with the distance beneath\n    closestNoteFinder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\"\n        }\n    },\n    // The same generator, but its button is armed by the nearest note rather than a typed prompt\n    imageGenerator: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\",\n            // Enabled while a search isn't running and the widget is beside a note (a distance of 0 still is)\n            cannotGenerate: {\n                $compute: {\n                    func: (isGenerating, distance) => isGenerating || distance === null,\n                    args: [\"{self}.isGenerating\", \"{closestNoteFinder}.distance\"]\n                }\n            },\n            // Pressing the button seeks an image for the nearest note's text, and pre-fills the prompt\n            generate: {\n                $method: {\n                    func: \"fluid.demos.noteImageGen.generateFromNote\",\n                    args: [\"{self}.state\", \"{closestNoteFinder}.noteText\", \"{closestNoteFinder}.distance\"]\n                }\n            }\n        }\n    }\n});\n\n/**\n * Seek an image of the sticky note nearest the widget, using the note's text as the prompt\n * @param {Object} state - The image generator subcomponent's reactive state\n * @param {String} noteText - The text of the closest note\n * @param {Number|null} distance - The distance to the closest note, or `null` if there is none\n * @return {Promise|undefined} The search's promise, so that everything it causes is a single undoable step\n */\nfluid.demos.noteImageGen.generateFromNote = function (state, noteText, distance) {\n    if (distance === null) {\n        state.error = \"Move the widget next to a sticky note first\";\n        return undefined;\n    }\n    state.prompt = noteText;\n    return fluid.demos.imageGenerator.generate(state);\n};\n</script>\n\n<template>\n    <div class=\"noteimagegen\">\n        <div class=\"noteimagegen-finder\" @id=\"closestNoteFinder\"></div>\n        <div class=\"noteimagegen-generator\" @id=\"imageGenerator\"></div>\n    </div>\n</template>\n\n<style>\n.noteimagegen {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    box-sizing: border-box;\n}\n\n/* Each container keeps the class of its subcomponent's root merged in; these selectors outweigh that root's\n   own 100% height rule (0-0-2 beats 0-0-1 regardless of load order) */\n.noteimagegen > .noteimagegen-finder {\n    flex: 0 1 auto;\n    height: auto;\n    min-height: 0;\n}\n\n.noteimagegen > .noteimagegen-generator {\n    flex: 1 1 auto;\n    height: auto;\n    min-height: 0;\n}\n</style>\n"
  },
