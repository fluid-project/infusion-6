    "fluid.demos.imageFromClosestNote": "// Combines the image generator with the closest-note finder: the text of the sticky note nearest to the widget\n// becomes the image prompt, so moving the widget next to a note and pressing the button generates an image of it\nfluid.def(\"fluid.demos.imageFromClosestNote\", {\n    $layers: [\"fluid.demos.imageGenerator\", \"fluid.topLevelWidget\"],\n    // Finds the closest note silently: it renders nothing, borrowing this widget's own view\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            view: \"{imageFromClosestNote}.view\"\n        }\n    },\n    // The closest note's text is the prompt, re-read whenever the widget moves\n    state: {\n        prompt: \"{finder}.noteText\"\n    },\n    buttonLabel: {\n        $compute: {\n            func: \"fluid.demos.imageFromClosestNote.buttonLabel\",\n            args: [\"{self}.isGenerating\"]\n        }\n    }\n});\n\nfluid.demos.imageFromClosestNote.buttonLabel = isGenerating =>\n    isGenerating ? \"Finding...\" : \"Generate image of closest note\";"
  },
