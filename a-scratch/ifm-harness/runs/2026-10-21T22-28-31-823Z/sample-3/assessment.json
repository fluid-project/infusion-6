    "fluid.demos.noteImageGen": "<script>\n// Composes fluid.demos.closestNoteFinder with fluid.demos.imageGenerator: the widget watches\n// the closest sticky note on the canvas, and pressing the button runs an image search for that\n// note's text.\n\nfluid.def(\"fluid.demos.noteImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 400,\n        h: 700\n    },\n    noteFinder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\"\n        }\n    },\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\"\n        }\n    },\n    generateFromClosest: {\n        $method: {\n            func: \"fluid.demos.noteImageGen.generateFromClosest\",\n            args: [\"{self}.noteFinder\", \"{self}.imageGen\"]\n        }\n    }\n});\n\n/**\n * Set the image generator's prompt to the closest note's text, and run the search for it.\n * The search's promise is returned so the whole operation is a single undoable step.\n * @param {Component} noteFinder - The closest-note finder subcomponent\n * @param {Component} imageGen - The image generator subcomponent\n */\nfluid.demos.noteImageGen.generateFromClosest = function (noteFinder, imageGen) {\n    const record = noteFinder.closest;\n    if (record.distance === null) {\n        imageGen.state.error = \"Move this widget next to a sticky note, then press Generate again\";\n        return;\n    }\n    imageGen.state.prompt = record.text;\n    return imageGen.generate();\n};\n</script>\n\n<template>\n    <div class=\"noteimg\">\n        <!-- The closest-note finder renders its own summary and distance line -->\n        <div @id=\"noteFinder\"></div>\n        <!-- One press takes the closest note's text straight to the image generator -->\n        <button class=\"noteimg-generate\" @onclick=\"{self}.generateFromClosest()\">Generate an image for this note</button>\n        <!-- The full image generator (prompt, results and credits) -->\n        <div @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.noteimg {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding: 16px;\n    box-sizing: border-box;\n    font-family: sans-serif;\n    background-color: #fff8e1;\n}\n\n.noteimg-generate {\n    flex: 0 0 auto;\n    align-self: center;\n    font: inherit;\n    font-weight: 600;\n    font-size: 16px;\n    padding: 10px 18px;\n    border: none;\n    border-radius: 8px;\n    background-color: #4a90d9;\n    color: #fff;\n    cursor: pointer;\n}\n</style>"
