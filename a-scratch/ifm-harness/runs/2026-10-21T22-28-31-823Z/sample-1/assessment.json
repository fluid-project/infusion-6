    "fluid.demos.noteImageGen": "<script>\n// Combines fluid.demos.closestNoteFinder and fluid.demos.imageGenerator: drag the widget next to a sticky note\n// and press \"Generate Image\" to have Pixabay generate an image from the note's text.\nfluid.def(\"fluid.demos.noteImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 400,\n        h: 720\n    },\n    // The finder computes the note closest to OUR bounds - it has no tldraw shape of its own, so its own\n    // hostBounds would come to nothing and the note text would never be found\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            hostBounds: \"{noteImageGen}.hostBounds\"\n        }\n    },\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\"\n        }\n    },\n    generateFromNote: {\n        $method: {\n            func: \"fluid.demos.noteImageGen.generateFromNote\",\n            args: [\"{self}\"]\n        }\n    }\n});\n\n/**\n * Put the closest note's text into the image generator's prompt and start a search\n * @param {Component} self - The umbrella component, proxy to which the method is invoked\n */\nfluid.demos.noteImageGen.generateFromNote = function (self) {\n    const imageGen = self.imageGen;\n    let closest;\n    try {\n        closest = self.finder.closest;\n    } catch (unavailable) {\n        closest = null;\n    }\n    if (!closest || closest.distance === null) {\n        imageGen.state.error = \"Move me next to a sticky note to use its text\";\n    } else if (!closest.text || closest.text === \"Empty note\") {\n        imageGen.state.error = \"That sticky note is empty - write a prompt in it first\";\n    } else {\n        imageGen.state.prompt = closest.text;\n        imageGen.generate();\n    }\n};\n</script>\n\n<template>\n    <div class=\"noteimagegen\">\n        <h3 class=\"noteimagegen-title\">Sticky Note Image Generator</h3>\n        <!-- The finder renders the closest note's text and, while it finds one, its distance -->\n        <div @id=\"finder\"></div>\n        <button class=\"noteimagegen-button\" @onclick=\"{self}.generateFromNote()\">Generate Image</button>\n        <!-- The full image generator: prompt input, its own Generate/Another buttons, result and messages -->\n        <div @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.noteimagegen {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n}\n\n.noteimagegen-title {\n    margin: 0 0 8px 0;\n    font-size: 14px;\n    color: #666;\n    text-align: center;\n}\n\n.noteimagegen-button {\n    margin: 8px 16px;\n    padding: 10px 16px;\n    font-size: 14px;\n    font-weight: 500;\n    color: #fff;\n    border: none;\n    background-color: #2e7d32;\n    cursor: pointer;\n    border-radius: 4px;\n}\n\n.noteimagegen-button:disabled {\n    background-color: #999;\n    cursor: not-allowed;\n}\n</style>"
  },
