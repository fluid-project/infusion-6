    "fluid.demos.noteDrivenImageGen": "<script>\n// Combines the closest-note finder with the image generator. The finder tracks the sticky note nearest\n// to this widget's own shape, and the generator's \"Find Image\" button takes its prompt from that note's\n// text - so the flow is: move the widget close to a note, press the button, get an image of the note's subject.\n\nfluid.def(\"fluid.demos.noteDrivenImageGen\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 380,\n        h: 680\n    },\n    // Track the note closest to this widget, using the bounds of the combined widget's own shape\n    finder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            // topLevelWidget feeds bounds only to the root component, so hand them down to the finder\n            hostBounds: \"{noteDrivenImageGen}.hostBounds\"\n        }\n    },\n    // Generate an image of whatever the finder points at, rather than a prompt typed by hand\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\",\n            // The button is live whenever the finder has a note to work from\n            cannotGenerate: \"$compute:fluid.demos.noteDrivenImageGen.cannotGenerate({self}.isGenerating, {finder}.distance)\",\n            // Seed the prompt with the closest note's text, then run the usual Pixabay search\n            generate: {\n                $method: {\n                    func: \"fluid.demos.noteDrivenImageGen.generate\",\n                    args: [\"{self}.state\", \"{finder}.closest\"]\n                }\n            }\n        }\n    }\n});\n\n/**\n * Enable the button whenever we are not already searching and a sticky note is in range\n * @param {Boolean} isGenerating - Whether a search is already under way\n * @param {Number|null} distance - Distance to the closest note, or `null` if there is none\n * @return {Boolean} `true` to disable the button\n */\nfluid.demos.noteDrivenImageGen.cannotGenerate = (isGenerating, distance) => isGenerating || distance === null;\n\n/**\n * Search Pixabay for an image matching the text of the closest sticky note\n * @param {Object} state - The image generator's reactive state\n * @param {Object} closest - The finder's closest note record ({text, distance})\n */\nfluid.demos.noteDrivenImageGen.generate = async function (state, closest) {\n    if (!closest || closest.distance === null) {\n        state.error = \"Move the widget close to a sticky note, then press Find Image\";\n    } else {\n        state.prompt = closest.text;\n        await fluid.demos.imageGenerator.generate(state);\n    }\n};\n</script>\n\n<template>\n    <div class=\"note-driven\">\n        <div @id=\"finder\"></div>\n        <div class=\"note-driven-gap\"></div>\n        <div @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.note-driven {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    font-family: sans-serif;\n}\n\n.note-driven-gap {\n    flex: 0 0 4px;\n}\n</style>"
  },
