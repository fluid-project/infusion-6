    "fluid.demos.noteImageGenerator": "<script>\nfluid.def(\"fluid.demos.noteImageGenerator\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {w: 660, h: 480},\n    // The note finder finds the sticky note nearest THIS widget, so it must read the umbrella's bounds\n    // rather than host bounds of its own, which it no longer has as a subcomponent\n    noteFinder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            hostBounds: \"{noteImageGenerator}.hostBounds\"\n        }\n    },\n    // The image generator searches for images of the nearest note's text, so moving this widget close to\n    // a sticky note fills the prompt and pressing its Find Image button generates an image of the note\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\",\n            state: {\n                prompt: \"{noteImageGenerator}.promptText\"\n            }\n        }\n    },\n    // Blank prompt while no note is in reach, so the button can't fire pointlessly\n    promptText: \"$compute:fluid.demos.noteImageGenerator.promptText({noteFinder}.noteText, {noteFinder}.distance)\"\n});\n\nfluid.demos.noteImageGenerator.promptText = (noteText, distance) => distance === null ? \"\" : noteText;\n</script>\n\n<template>\n    <div class=\"noteimagegen\">\n        <div class=\"noteimagegen-finder\" @id=\"noteFinder\"></div>\n        <div class=\"noteimagegen-generator\" @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.noteimagegen {\n    display: flex;\n    gap: 16px;\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n}\n\n.noteimagegen-finder {\n    flex: 0 0 280px;\n    min-width: 0;\n}\n\n.noteimagegen-generator {\n    flex: 1;\n    min-width: 0;\n}\n</style>"
