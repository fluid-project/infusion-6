    "fluid.demos.closestImageGenerator": "<script>\n// Umbrella layer combining the two selected widgets: the closest-note finder shows the sticky note\n// nearest to the widget (recomputed as it is moved on the canvas), and a single button copies that\n// note's text into the image generator's prompt and starts the Pixabay search. Neither existing layer\n// is modified - they are composed as subcomponents, with `closest` overridden so that our host bounds\n// drive it (hostBounds is supplied to the hosted top-level widget, not to a subcomponent).\n\nfluid.def(\"fluid.demos.closestImageGenerator\", {\n    $layers: \"fluid.topLevelWidget\",\n    preferredSize: {\n        w: 380,\n        h: 720\n    },\n    noteFinder: {\n        $component: {\n            $layers: \"fluid.demos.closestNoteFinder\",\n            closest: \"$compute:fluid.demos.closestNoteFinder.findClosest({tldrawHost}.notes, {closestImageGenerator}.hostBounds)\"\n        }\n    },\n    imageGen: {\n        $component: {\n            $layers: \"fluid.demos.imageGenerator\"\n        }\n    },\n    generateFromNote: {\n        $method: {\n            func: \"fluid.demos.closestImageGenerator.generateFromNote\",\n            args: [\"{noteFinder}:finder\", \"{imageGen}:generator\"]\n        }\n    }\n});\n\n/**\n * Use the closest note as the image prompt: copy its text into the generator's prompt and start\n * the search, guiding the user if there is no usable note nearby.\n * @param {Component} finder - The closest-note finder subcomponent\n * @param {Component} generator - The image generator subcomponent\n */\nfluid.demos.closestImageGenerator.generateFromNote = function (finder, generator) {\n    const closest = finder.closest;\n    if (!closest || closest.distance === null) {\n        generator.state.error = \"No sticky note nearby - move the widget next to one, then press the button again\";\n    } else if (closest.text === \"Empty note\") {\n        generator.state.error = \"The closest sticky note is empty - put some words in it first\";\n    } else {\n        generator.state.prompt = closest.text;\n        generator.generate();\n    }\n};\n</script>\n\n<template>\n    <div class=\"closest-imagegen\">\n        <div class=\"closest-imagegen-finder\" @id=\"noteFinder\"></div>\n        <button class=\"closest-imagegen-button\" disabled=\"@{imageGen.isGenerating}\"\n                @onclick=\"{self}.generateFromNote()\">Generate image of the closest note</button>\n        <div class=\"closest-imagegen-gen\" @id=\"imageGen\"></div>\n    </div>\n</template>\n\n<style>\n.closest-imagegen {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    font-family: sans-serif;\n}\n\n.closest-imagegen-finder {\n    flex: 0 0 auto;\n}\n\n.closest-imagegen-button {\n    font: inherit;\n    padding: 10px;\n    background-color: #4a90d9;\n    color: #fff;\n    border: none;\n    cursor: pointer;\n    transition: background-color 0.2s;\n}\n\n.closest-imagegen-button:hover:not(:disabled) {\n    background-color: #3a7bc8;\n}\n\n.closest-imagegen-button:disabled {\n    background-color: #999;\n    cursor: not-allowed;\n}\n\n.closest-imagegen-gen {\n    flex: 1 1 auto;\n    min-height: 0;\n}\n</style>"
  },
