fluid.def("fluid.tldrawViewComponent", {
    $layers: "fluid.topLevelWidgetView",
    shapeId: null,
    editor: "{tldrawHost}.editor",
    hostBounds: {
        $bindable: {
            bind: "fluid.tldraw.bindShapeBounds({self}.editor, {self}.shapeId)",
            unbind: "fluid.tldraw.stopReactiveCell({boundValue})"
        }
    }
});

