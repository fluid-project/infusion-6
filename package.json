{
    "name": "infusion-6",
    "description": "Infusion is an application framework for developing flexible stuff with JavaScript",
    "version": "6.7.5",
    "author": "Fluid Project",
    "bugs": "https://issues.fluidproject.org/browse/FLUID",
    "homepage": "https://www.fluidproject.org/",
    "license": "(BSD-3-Clause OR ECL-2.0)",
    "keywords": [
        "infusion",
        "framework",
        "application",
        "fluid",
        "IL",
        "Integration Language",
        "FRP",
        "reactive programming",
        "signals"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fluid-project/infusion-6.git"
    },
    "main": "./src/framework/server/fluid.js",
    "//workspaces": "Packages released from this repository independently of Infusion, by npm run release - see scripts/publishOutdated.js. packages/ is left out of Infusion's own package by .npmignore",
    "workspaces": [
        "packages/wend",
        "packages/wend-theme-beautiful"
    ],
    "bin": {
        "fluid-hydrate": "bin/fluid-hydrate.js",
        "fluid-dehydrate": "bin/fluid-dehydrate.js",
        "fluid-copyout": "bin/fluid-copyout.js"
    },
    "scripts": {
        "clean": "run-p clean:*",
        "clean:build": "rimraf build products",
        "clean:tsc": "rimraf --glob \"src/framework/core/mjs/*.d.mts\" \"src/framework/core/mjs/*.d.mts.map\"",
        "deps": "run-p deps:*",
        "deps:preact-signals-core": "cpy node_modules/@preact/signals-core/dist/signals-core.min.js src/lib/preact-signals/",
        "deps:preact-signals-core-map": "cpy node_modules/@preact/signals-core/dist/signals-core.min.js.map src/lib/preact-signals/",
        "deps:preact-signals": "cpy node_modules/@preact/signals/dist/signals.min.js src/lib/preact/",
        "deps:preact-signals-map": "cpy node_modules/@preact/signals/dist/signals.min.js.map src/lib/preact/",
        "deps:preact": "cpy node_modules/preact/dist/preact.min.js src/lib/preact/",
        "deps:preact-map": "cpy node_modules/preact/dist/preact.min.js.map src/lib/preact/",
        "deps:preact-hooks": "cpy node_modules/preact/hooks/dist/hooks.umd.js src/lib/preact/",
        "deps:preact-hooks/map": "cpy node_modules/preact/hooks/dist/hooks.umd.js.map src/lib/preact/",
        "tsc": "tsc",
        "es6-transform": "node es6-transform.js",
        "es6-bundle": "node es6-bundle.js fluid-cell",
        "build": "node build.js",
        "build-fluid-cell": "run-s es6-transform clean:tsc tsc es6-bundle",
        "lint": "eslint --format ./packages/fluid-lint/eslint-summary-formatter.cjs src/framework src/components tests demo packages extension scripts bin *.js .puppeteerrc.cjs",
        "test": "node tests/test-core/qunit/js/fqunit-cli.js",
        "release": "node scripts/publishOutdated.js",
        "//npm-release": "Releases as before, to the npm registry, held in reserve for special cases - everyday releases attach their tarballs to GitHub releases instead, see scripts/publishOutdated.js",
        "npm-release": "node scripts/publishOutdated.js --npm",
        "npm-release:dry-run": "node scripts/publishOutdated.js --npm --dry-run",
        "zip:extension": "node scripts/zipExtension.js",
        "test:browser": "node tests/test-core/browser/js/demo-runner.js",
        "test:extension": "node extension/test/signin-scenario.js && node extension/test/framing-scenario.js && node extension/test/publish-race-scenario.js && node extension/test/block-editor-scenario.js && node extension/test/list-scenario.js && node extension/test/changeset-scenario.js && node extension/test/drop-scenario.js && node extension/test/widget-scenario.js && node extension/test/inherit-scenario.js && node extension/test/ai-scenario.js && node extension/test/commit-review-scenario.js && node extension/test/panel-scenario.js",
        "test:server": "run-s hydrate-test hydrate-roundtrip-test copyout-test output-documents-test document-trace-test",
        "test:packages": "npm --prefix packages/fluid-lint test && npm --prefix packages/eslint-plugin-fluid-lint test",
        "release:dry-run": "node scripts/publishOutdated.js --dry-run",
        "test:packed": "node scripts/testPacked.js",
        "//test-all": "Every test bearing on whether a release is sound, cheapest first, stopping at the first failure - what would be published is shown separately, by release:dry-run. The extension's scenarios are run by test:packed, against packages/wend-test-site installed from the tarballs a release would publish - see scripts/testPacked.js",
        "test-all": "run-s lint test test:server test:packages test:browser-qunit test:browser test:packed",
        "test:browser-qunit": "node tests/test-core/browser/js/qunit-browser-runner.js",
        "hydrate-test": "node tests/framework-tests/server/hydrate-test.js",
        "hydrate-roundtrip-test": "node tests/framework-tests/server/hydrate-roundtrip-test.js",
        "copyout-test": "node tests/framework-tests/server/copyout-test.js",
        "output-documents-test": "node tests/framework-tests/server/output-documents-test.js",
        "document-trace-test": "node tests/framework-tests/server/document-trace-test.js"
    },
    "engines": {
        "node": ">=18"
    },
    "browserslist": [
        "extends browserslist-config-fluid"
    ],
    "dependencies": {
        "he": "1.2.0",
        "json5": "2.2.3",
        "linkedom": "0.18.10",
        "minimist": "1.2.6"
    },
    "devDependencies": {
        "@preact/signals": "2.0.1",
        "@preact/signals-core": "1.7.0",
        "acorn": "8.14.1",
        "acorn-loose": "8.5.0",
        "browserslist-config-fluid": "0.1.0",
        "cpy": "13.2.3",
        "cpy-cli": "7.0.0",
        "eslint": "10.15.0",
        "eslint-config-infusion-6": "file:packages/eslint-config-infusion-6",
        "eslint-plugin-fluid-lint": "file:packages/eslint-plugin-fluid-lint",
        "fflate": "0.8.3",
        "fs-extra": "11.2.0",
        "glob": "14.0.6",
        "npm-run-all2": "9.1.0",
        "preact": "10.25.4",
        "puppeteer": "25.18.1",
        "qunit": "2.21.0",
        "rimraf": "6.1.4",
        "terser": "5.39.0"
    },
    "infusion": {
        "imports": {
            "client": [
                "src/framework/core/js/FluidCore.js",
                "src/framework/core/js/FluidSignals.js",
                "src/framework/core/js/Fluid.js",
                "src/framework/core/js/FluidModules.js",
                "src/framework/core/js/FluidIL.js",
                "src/framework/core/js/FluidView.js",
                "src/framework/core/js/FluidPTF.js",
                "src/framework/core/js/template-parser.js",
                "src/framework/core/js/FluidView-browser.js"
            ],
            "server": [
                "src/framework/core/js/FluidCore.js",
                "src/framework/core/js/FluidSignals.js",
                "src/framework/core/js/Fluid.js",
                "src/framework/core/js/FluidModules.js",
                "src/framework/core/js/FluidIL.js",
                "src/framework/core/js/FluidView.js",
                "src/framework/core/js/FluidPTF.js",
                "src/framework/core/js/FluidView-node.js",
                "src/framework/core/js/template-parser.js"
            ]
        },
        "tests": {
            "server": [
                "tests/framework-tests/core/html/FluidCoreTests.html",
                "tests/framework-tests/core/html/FluidJSTests.html",
                "tests/framework-tests/core/html/FluidMicroSQLTests.html",
                "tests/framework-tests/core/html/FluidSignalsTests.html",
                "tests/framework-tests/core/html/FluidSignalsGraphTests.html",
                "tests/framework-tests/core/html/FluidSignalsAsyncTests.html",
                "tests/framework-tests/core/html/FluidILTests.html",
                "tests/framework-tests/core/html/FluidViewTests.html",
                "tests/framework-tests/core/html/FluidViewSFCTests.html",
                "tests/framework-tests/core/html/FluidPTFTests.html",
                "tests/framework-tests/components/html/ResizeBarTests.html",
                "tests/framework-tests/components/html/AskAnythingTests.html",
                "tests/framework-tests/components/html/LiveExampleTests.html",
                "tests/framework-tests/components/html/MarkdownSerializerTests.html",
                "tests/framework-tests/from-demos/html/TodoListTests.html",
                "tests/framework-tests/from-demos/html/TodoListAssignTests.html",
                "tests/framework-tests/from-demos/html/TldrawAITests.html"
            ],
            "browser": [
                "demo/compose-edit/demo-script.json",
                "demo/tldraw/demo-script.json",
                "demo/tldraw/inspector-script.json"
            ]
        }
    },
    "allowScripts": {
        "puppeteer@25.18.1": true
    }
}
