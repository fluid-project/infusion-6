{
    "name": "fluid-lint",
    "version": "1.0.0",
    "private": true,
    "description": "Linting of Infusion 6 JavaScript and Single File Components - a lezer grammar of the runes of configuration, nested within JavaScript and SFCs, and a linter of layer records, for CodeMirror 6 and node",
    "license": "(BSD-3-Clause OR ECL-2.0)",
    "main": "src/fluidLint.js",
    "scripts": {
        "grammar": "lezer-generator grammar/fluid-runes.grammar -o src/fluid-runes.parser.js",
        "bundle": "node build.js",
        "build": "npm run grammar && npm run bundle",
        "test": "node test/lintTests.js"
    },
    "dependencies": {
        "@lezer/common": "1.5.5",
        "@lezer/highlight": "1.2.5",
        "@lezer/html": "1.3.13",
        "@lezer/javascript": "1.5.6",
        "@lezer/lr": "1.4.12"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "6.20.4",
        "@codemirror/commands": "6.8.1",
        "@codemirror/lang-html": "6.4.12",
        "@codemirror/lang-javascript": "6.2.5",
        "@codemirror/language": "6.11.0",
        "@codemirror/lint": "6.9.8",
        "@codemirror/search": "6.5.10",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@lezer/generator": "1.8.1",
        "esbuild": "0.25.4"
    },
    "type": "module"
}
