{
    "manifest_version": 3,
    "name": "Edit in Infusion",
    "version": "1.0.5",
    "description": "Edit a statically published site in place, on pages which advertise their sources with a Fluid provenance record",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "contextMenus",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://api.github.com/*",
        "https://github.com/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_title": "Edit in Infusion",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_page": "options.html",
    "web_accessible_resources": [
        {
            "resources": [
                "js/bridge.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ]
}
