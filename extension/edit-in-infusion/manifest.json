{
    "manifest_version": 3,
    "name": "Edit in Infusion",
    "version": "0.1.0",
    "description": "Edit a statically published site in place, on pages which advertise their sources with a Fluid linkage record",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://api.github.com/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_title": "Edit in Infusion - click to edit this site",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_page": "options.html",
    "web_accessible_resources": [
        {
            "resources": [
                "js/bridge.js",
                "js/fluid-withEditing.js",
                "js/fluid-markdownSerializer.js",
                "sfc/fluid-blockEditor.vue"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ]
}
